<?xml version="1.0" encoding="UTF-8"?>
<!-- One of Juku's scheduled jobs on Arthur's Mac: the nightly backup, or the hourly weekly-run check.
     juku.sh install-schedule fills in the placeholders and installs one copy per job in
     ~/Library/LaunchAgents; this file is only the template. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>@AGENT@</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>@JUKU_SH@</string><string>@COMMAND@</string></array>
  @SCHEDULE@
  <!-- Docker and age are in Homebrew's folder, which a LaunchAgent's PATH doesn't include by default. -->
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string></dict>
  <key>StandardOutPath</key><string>@LOG@</string>
  <key>StandardErrorPath</key><string>@LOG@</string>
</dict>
</plist>
