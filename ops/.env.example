# Non-secret settings for ops/compose.yaml. Copy to ops/.env and fill in.
# Secrets never go here: they are files in ops/secrets/ (ops/make-secrets.sh).

# The chat the Telegram bot messages (Arthur's only); the token is ops/secrets/telegram_bot_token.
JUKU_TELEGRAM_CHAT_ID=replace-with-the-chat-id
# The managed database (ADR-016): its host and port. make-secrets.sh builds
# the URLs from them, and Grafana's data source reads them.
JUKU_DB_HOST=db.example.invalid
JUKU_DB_PORT=5432
# Where Grafana is reached, behind the proxy.
JUKU_GRAFANA_ROOT_URL=https://dashboard.example.invalid
# Loopback ports the proxy forwards to.
JUKU_APP_PORT=8080
JUKU_GRAFANA_PORT=3000
# The gateway: its address on its client network, the two Docker networks
# its own deployment makes, and the folder holding its audit log.
JUKU_GATEWAY_URL=http://mcp-gateway:8000
JUKU_GATEWAY_CLIENTS_NETWORK=mcp-gateway-clients
JUKU_GATEWAY_UPSTREAMS_NETWORK=mcp-gateway-upstreams
JUKU_GATEWAY_AUDIT_DIR=/path/to/the/gateways/audit/folder
# Project 6's collector (OTLP over HTTP). Empty: no traces are exported.
JUKU_OTLP_ENDPOINT=
# Indonesia's official mental-health line, shown in Shiori's fixed reply to a
# learner in distress (AG6). Check the number on an official source first.
JUKU_CRISIS_LINE=replace-after-checking-the-number
# Arthur's own learner public ID (from the database, after he signs up): opens the Run Inspector.
JUKU_ADMIN_PUBLIC_IDS=
