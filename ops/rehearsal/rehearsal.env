# ops/.env's settings for a laptop rehearsal (ops/rehearse.sh). Nothing here
# is secret or real: the database is the local `db` container, and there is
# no Telegram chat, so alerts fire in Grafana but aren't delivered.
JUKU_DB_HOST=db
JUKU_DB_PORT=5432
JUKU_TELEGRAM_CHAT_ID=0
JUKU_CRISIS_LINE=rehearsal-only
JUKU_APP_PORT=58080
JUKU_GRAFANA_PORT=53000
JUKU_GRAFANA_ROOT_URL=http://127.0.0.1:53000
JUKU_GATEWAY_URL=http://mcp-gateway:8000
JUKU_GATEWAY_AUDIT_DIR=./gateway-audit
JUKU_OTLP_ENDPOINT=
JUKU_REHEARSAL_DB_PORT=55450
