# Type stubs for the part of SudachiPy 0.7 that Juku uses. SudachiPy ships
# no type information, and pyright is strict on Juku's code.
from collections.abc import Iterator
from enum import Enum

class SplitMode(Enum):
    A = ...
    B = ...
    C = ...

class Morpheme:
    def surface(self) -> str: ...
    def part_of_speech(self) -> tuple[str, ...]: ...
    def dictionary_form(self) -> str: ...
    def normalized_form(self) -> str: ...
    def reading_form(self) -> str: ...

class MorphemeList:
    def __iter__(self) -> Iterator[Morpheme]: ...
    def __len__(self) -> int: ...
    def __getitem__(self, index: int) -> Morpheme: ...

class Tokenizer:
    def tokenize(self, text: str) -> MorphemeList: ...

class Dictionary:
    def __init__(self, *, dict: str = ...) -> None: ...
    def tokenizer(self, mode: SplitMode = ...) -> Tokenizer: ...
