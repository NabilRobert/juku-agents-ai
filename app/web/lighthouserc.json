{
  "ci": {
    "collect": {
      "staticDistDir": "../../build/previews",
      "url": [
        "http://localhost/beranda.html",
        "http://localhost/kuis.html",
        "http://localhost/chat.html",
        "http://localhost/bacaan.html",
        "http://localhost/rencana.html",
        "http://localhost/ingat.html"
      ],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "resource-summary:script:size": ["error", { "maxNumericValue": 102400, "aggregationMethod": "median" }],
        "resource-summary:stylesheet:size": ["error", { "maxNumericValue": 30720, "aggregationMethod": "median" }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500, "aggregationMethod": "median" }],
        "total-blocking-time": ["error", { "maxNumericValue": 200, "aggregationMethod": "median" }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1, "aggregationMethod": "median" }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": "../../build/lighthouse" }
  }
}
